{
  "name": "desktop",
  "private": true,
  "version": "5.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:node": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test": "npm run test:node && npm run test:unit",
    "lint": "eslint . --max-warnings 0",
